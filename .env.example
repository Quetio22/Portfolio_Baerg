# Domaine public réel, sans chemin ni slash final. Vide = prévisualisation non indexable.
SITE_URL=
PORT=3000
HOST=127.0.0.1
# Passer à true uniquement après avoir complété les informations légales dans src/content.js.
PUBLICATION_READY=false
# Envoi serveur via Resend, avec un domaine d'expédition vérifié.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# Facultatif : une adresse IP de proxy fiable. Ne jamais faire confiance à tous les proxies.
TRUSTED_PROXY_IP=
